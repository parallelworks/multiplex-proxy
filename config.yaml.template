# pw-multiplex-proxy config.
# Auth is handled by the pw CLI — run `pw auth token` or `pw auth apikey` first.
# See: https://parallelworks.com/docs/cli/pw/auth

ssh:
  identityFile: ~/.ssh/pwcli                  # managed by `pw auth`
  user: USERNAME                              # your pw username
  jumpHost: workspace                         # short name of your ACTIVATE workspace
  proxyCommand: "pw ssh --proxy-command %h"   # tunnel through ACTIVATE

sites:
  - host: app.example.com
    port: 443
    localPort: 10443
  - host: api.example.com
    port: 443
    localPort: 10444
